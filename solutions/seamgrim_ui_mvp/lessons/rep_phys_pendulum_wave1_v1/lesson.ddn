설정 {
  제목: "진자 보기 코어".
  설명: "줄 길이, 중력, 처음 각도, 마디 간격을 바꾸며 진자의 위치와 각도를 같은 틱에서 봅니다.".
  마디수: 240.
}.

채비 {
  g:수 := (9.8) 매김 { 범위: 1..20. 간격: 0.1. }.
  L:수 := (1) 매김 { 범위: 0.2..3. 간격: 0.1. }.
  theta0:수 := (0.5) 매김 { 범위: -1.2..1.2. 간격: 0.05. }.
  omega0:수 := (0) 매김 { 범위: -3..3. 간격: 0.05. }.
  damp:수 := (0.02) 매김 { 범위: 0..0.2. 간격: 0.005. }.
  dt:수 := (0.02) 매김 { 범위: 0.005..0.1. 간격: 0.005. }.
  t_max:수 := (8) 매김 { 범위: 1..20. 간격: 0.5. }.
}.

(시작)할때 {
  t <- 0.
  theta <- theta0.
  omega <- omega0.
}.

(매마디)마다 {
  { t <= t_max }이면 {
    alpha <- -(g / L) * ((theta) sin) - damp * omega.
    omega <- omega + alpha * dt.
    theta <- theta + omega * dt.
  }.

  speed <- L * omega.
  kinetic_energy <- 0.5 * speed * speed.
  potential_energy <- g * L * (1 - ((theta) cos)).
  energy <- kinetic_energy + potential_energy.
  bob_x <- L * ((theta) sin).
  bob_y <- -L * ((theta) cos).

  모양 {
    선(0, 0, bob_x, bob_y, 색="#475569", 굵기=0.018).
    원(bob_x, bob_y, r=0.08, 색="#38bdf8", 선색="#0ea5e9", 굵기=0.018).
    점(0, 0, 크기=0.05, 색="#f59e0b").
  }.

  무리 <- "각도".
  무리 보여주기.
  t 보여주기.
  theta 보여주기.

  무리 <- "각속도".
  무리 보여주기.
  t 보여주기.
  omega 보여주기.

  무리 <- "전체 에너지".
  무리 보여주기.
  t 보여주기.
  energy 보여주기.

  무리 <- "운동 에너지".
  무리 보여주기.
  t 보여주기.
  kinetic_energy 보여주기.

  무리 <- "위치 에너지".
  무리 보여주기.
  t 보여주기.
  potential_energy 보여주기.

  { t <= t_max }이면 {
    t <- t + dt.
  }.
}.
