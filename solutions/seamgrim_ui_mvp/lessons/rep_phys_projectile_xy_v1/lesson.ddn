설정 {
  제목: "포물선 운동".
  설명: "초기 속도와 중력을 바꾸며 포물선 운동을 관찰합니다.".
  마디수: 240.
}.

채비 {
  초기속도x: 수 := (8.0) 매김 { 범위: 1..30. 간격: 1. }.
  초기속도y: 수 := (15.0) 매김 { 범위: 1..40. 간격: 1. }.
  중력가속도: 수 := (9.8) 매김 { 범위: 1..20. 간격: 0.1. }.
  dt: 수 := (0.1) 매김 { 범위: 0.02..0.5. 간격: 0.01. }.
  마디수: 수 := (240.0) 매김 { 범위: 20..800. 간격: 1. }.
}.

(시작)할때 {
  t <- 0.
  x <- 0.
  y <- 0.
  vx <- 초기속도x.
  vy <- 초기속도y.
}.

(매마디)마다 {
  { t < 마디수 }이면 {
    x <- x + vx * dt.
    y <- y + vy * dt.
    vy <- vy - 중력가속도 * dt.

    { y < 0 }이면 {
      y <- 0.
      t <- 마디수.
    }.

    모양 {
      선(0, 0, 40, 0, 색="#94a3b8", 굵기=0.06).
      선(0, 0, 0, 초기속도y, 색="#94a3b8", 굵기=0.06).
      선(0, 0, x, y, 색="#7dd3fc", 굵기=0.04).
      원(x, y, r=0.35, 색="#38bdf8", 선색="#0ea5e9", 굵기=0.06).
      점(x, y, 크기=0.12, 색="#f59e0b").
    }.

    t <- t + 1.
  }.
}.
