// 포물선 운동: 으뜸 위치, 겹 속도 화살표, 곁 시간-가로위치 / 시간-높이 표본, 돋 현재 위치.
// 단위는 초·미터·미터/초. 시간 그래프는 원문이 계산한 표본 장면이다.
(x:수,y:수) 위치그림:보기값:셈씨 := {
  공 := (중심=차림[x,y],반지름=0.22) 표준장면.원.
  바닥 := (꼭짓점들=차림[차림[0,-0.08],차림[10,-0.08],차림[10,0],차림[0,0]]) 표준장면.다각형.
  안내 := (자리=차림[0,5.7],내용="포물선 운동 · 위치 (m)") 표준장면.글.
  장면 := (요소들=차림[공,바닥,안내],가로범위=차림[-1,11],세로범위=차림[-1,6]) 표준장면.평면.
  위치그림 <- (장면=장면) 표준보기.장면.
}.
(x:수,y:수,vx:수,vy:수) 속도그림:보기값:셈씨 := {
  // 화살표 길이 1 m는 속도 5 m/s를 나타낸다.
  dx := vx / 5. dy := vy / 5.
  안내 := (자리=차림[0,4.8],내용="겹: 속도 화살표 · 1 m = 5 m/s") 표준장면.글.
  요소들 <- 차림[안내].
  { vx != 0 또는 vy != 0 }이면 {
    화살 <- (꼭짓점들=차림[
    차림[x-dy*0.04,y+dx*0.04],
    차림[x+dx*0.75-dy*0.04,y+dy*0.75+dx*0.04],
    차림[x+dx*0.75-dy*0.12,y+dy*0.75+dx*0.12],
    차림[x+dx,y+dy],
    차림[x+dx*0.75+dy*0.12,y+dy*0.75-dx*0.12],
    차림[x+dx*0.75+dy*0.04,y+dy*0.75-dx*0.04],
    차림[x+dy*0.04,y-dx*0.04]
    ]) 표준장면.다각형.
    요소들 <- (요소들,화살) 추가.
  } 아니면 {
    정지안내 <- (자리=차림[0,4],내용="속도 0 m/s · 방향과 길이가 없어 화살표를 그리지 않음") 표준장면.글.
    요소들 <- (요소들,정지안내) 추가.
  }.
  장면 := (요소들=요소들,가로범위=차림[-1,11],세로범위=차림[-1,6]) 표준장면.평면.
  속도그림 <- (장면=장면) 표준보기.장면.
}.
(현재시간:수,현재높이:수) 시간높이그림:보기값:셈씨 := {
  안내 := (자리=차림[0,5],내용="곁: 시간 t(s) / 높이 y(m) · 표본 간격 0.1 s") 표준장면.글.
  요소들 <- 차림[안내]. n <- 0.
  { n <= 20 }인 동안 {
    t <- n / 10. h <- 10 * t - 5 * t * t.
    점 <- (중심=차림[t,h],반지름=0.025) 표준장면.원.
    요소들 <- (요소들,점) 추가. n <- n + 1.
  }.
  현재점 := (중심=차림[현재시간,현재높이],반지름=0.08) 표준장면.원.
  요소들 <- (요소들,현재점) 추가.
  장면 := (요소들=요소들,가로범위=차림[-0.2,2.2],세로범위=차림[-0.5,6]) 표준장면.평면.
  시간높이그림 <- (장면=장면) 표준보기.장면.
}.
(현재시간:수,현재위치:수) 시간가로그림:보기값:셈씨 := {
  안내 := (자리=차림[0,11],내용="곁: 시간 t(s) / 가로위치 x(m) · 표본 간격 0.1 s") 표준장면.글.
  요소들 <- 차림[안내]. n <- 0.
  { n <= 20 }인 동안 {
    t <- n / 10. x <- 5 * t.
    점 <- (중심=차림[t,x],반지름=0.025) 표준장면.원.
    요소들 <- (요소들,점) 추가. n <- n + 1.
  }.
  현재점 := (중심=차림[현재시간,현재위치],반지름=0.08) 표준장면.원.
  요소들 <- (요소들,현재점) 추가.
  장면 := (요소들=요소들,가로범위=차림[-0.2,2.2],세로범위=차림[-1,12]) 표준장면.평면.
  시간가로그림 <- (장면=장면) 표준보기.장면.
}.
(대상:장면요소값) 위치자세히:보기값:셈씨 := {
  안내 := (자리=차림[0,5.7],내용="돋: 공 · 아래에 현재 x-y 좌표") 표준장면.글.
  장면 := (요소들=차림[대상,안내],가로범위=차림[-1,11],세로범위=차림[-1,6]) 표준장면.평면.
  위치자세히 <- (장면=장면) 표준보기.장면.
}.
(시작)할때 { 초기화됨 <- 0. }.
(매마디)마다 {
  { 초기화됨 == 0 }이면 { 시간 <- 0. 초기화됨 <- 1. }.
  시간 <- 시간 + 0.02.
  { 시간 > 2 }이면 { 시간 <- 0. }.
  x <- 5 * 시간. y <- 10 * 시간 - 5 * 시간 * 시간.
  vx <- 5. vy <- 10 - 10 * 시간.
}.
위치보기 := (보기=((x=x,y=y) 위치그림)) 표준보개.으뜸.
속도보기 := (보기=((x=x,y=y,vx=vx,vy=vy) 속도그림),기준=위치보기,순서=1) 표준보개.겹.
가로시간보기 := (보기=((현재시간=시간,현재위치=x) 시간가로그림),자리=#오른쪽) 표준보개.곁.
높이시간보기 := (보기=((현재시간=시간,현재높이=y) 시간높이그림),자리=#오른쪽) 표준보개.곁.
공대상 := (중심=차림[x,y],반지름=0.22) 표준장면.원.
돋보기 := (대상=공대상,보기법=위치자세히) 표준보개.돋.
포물선짜임 := (관계들=차림[위치보기,속도보기,가로시간보기,높이시간보기,돋보기]) 표준보개.짜임.
(시간:시간,x:x,y:y,vx:vx,vy:vy) 내보임.
