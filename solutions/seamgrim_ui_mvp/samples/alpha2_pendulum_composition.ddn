// 진자: 으뜸 추, 겹 각도·수직 기준, 곁 시간-각도 / 시간-에너지, 돋 추.
// 길이 1 m, 중력가속도 9.8 m/s², 질량 1 kg. 작은각 근사 진자이다.
(x:수,y:수) 진자그림:보기값:셈씨 := {
  줄 := (꼭짓점들=차림[차림[-0.008,0],차림[0.008,0],차림[x+0.008,y],차림[x-0.008,y]]) 표준장면.다각형.
  추 := (중심=차림[x,y],반지름=0.08) 표준장면.원.
  고정점 := (중심=차림[0,0],반지름=0.03) 표준장면.원.
  장면 := (요소들=차림[줄,추,고정점],가로범위=차림[-1.3,1.3],세로범위=차림[-1.4,0.4]) 표준장면.평면.
  진자그림 <- (장면=장면) 표준보기.장면.
}.
(각:수) 각도기준그림:보기값:셈씨 := {
  수직 := (꼭짓점들=차림[차림[-0.006,0],차림[0.006,0],차림[0.006,-1.2],차림[-0.006,-1.2]]) 표준장면.다각형.
  요소들 <- 차림[수직].
  // 0 rad에서 삼각형은 퇴화하므로 수직 기준만 그린다.
  { 각 > 0.0001 또는 각 < -0.0001 }이면 {
    각표시 <- (꼭짓점들=차림[차림[0,0],차림[0,-0.25],차림[0.25*((각) sin),-0.25*((각) cos)]]) 표준장면.다각형.
    요소들 <- (요소들,각표시) 추가.
  }.
  안내 := (자리=차림[-1.15,0.2],내용="겹: 수직 기준과 각도 (rad)") 표준장면.글.
  요소들 <- (요소들,안내) 추가.
  장면 := (요소들=요소들,가로범위=차림[-1.3,1.3],세로범위=차림[-1.4,0.4]) 표준장면.평면.
  각도기준그림 <- (장면=장면) 표준보기.장면.
}.
(시간:수,각:수) 진자각도그림:보기값:셈씨 := {
  안내 := (자리=차림[0,0.7],내용="곁: 시간 t(s) / 각도 θ(rad) · 표본 간격 0.1 s") 표준장면.글.
  요소들 <- 차림[안내]. n <- 0.
  { n <= 40 }인 동안 {
    t <- n / 10. a <- 0.5 * ((3.130495168 * t) cos).
    각점 <- (중심=차림[t,a],반지름=0.025) 표준장면.원.
    요소들 <- (요소들,각점) 추가. n <- n + 1.
  }.
  현재각 := (중심=차림[시간,각],반지름=0.075) 표준장면.원.
  요소들 <- (요소들,현재각) 추가.
  장면 := (요소들=요소들,가로범위=차림[-0.3,4.3],세로범위=차림[-0.7,0.9]) 표준장면.평면.
  진자각도그림 <- (장면=장면) 표준보기.장면.
}.
(시간:수,에너지:수) 진자에너지그림:보기값:셈씨 := {
  안내 := (자리=차림[0,1.7],내용="곁: 시간 t(s) / 총 에너지 E(J) · 작은각 모형") 표준장면.글.
  요소들 <- 차림[안내]. n <- 0.
  { n <= 40 }인 동안 {
    t <- n / 10.
    // 질량 1 kg, g=9.8, theta0=0.5: 총 에너지 0.5*g*theta0² = 1.225 J.
    점 <- (중심=차림[t,1.225],반지름=0.025) 표준장면.원.
    요소들 <- (요소들,점) 추가. n <- n + 1.
  }.
  현재점 := (중심=차림[시간,에너지],반지름=0.075) 표준장면.원.
  요소들 <- (요소들,현재점) 추가.
  장면 := (요소들=요소들,가로범위=차림[-0.3,4.3],세로범위=차림[0,2]) 표준장면.평면.
  진자에너지그림 <- (장면=장면) 표준보기.장면.
}.
(대상:장면요소값) 추자세히:보기값:셈씨 := {
  안내 := (자리=차림[-1.15,0.2],내용="돋: 추 · 아래에 현재 좌표") 표준장면.글.
  장면 := (요소들=차림[대상,안내],가로범위=차림[-1.3,1.3],세로범위=차림[-1.4,0.4]) 표준장면.평면.
  추자세히 <- (장면=장면) 표준보기.장면.
}.
(대상:장면요소값) 고정점자세히:보기값:셈씨 := {
  안내 := (자리=차림[-1.15,0.2],내용="돋: 고정점 · 원점 (0, 0)") 표준장면.글.
  장면 := (요소들=차림[대상,안내],가로범위=차림[-1.3,1.3],세로범위=차림[-1.4,0.4]) 표준장면.평면.
  고정점자세히 <- (장면=장면) 표준보기.장면.
}.
(시작)할때 { 초기화됨 <- 0. }.
(매마디)마다 {
  { 초기화됨 == 0 }이면 { 시간 <- 0. 초기화됨 <- 1. }.
  시간 <- 시간 + 0.02. { 시간 > 4 }이면 { 시간 <- 0. }.
  각도 <- 0.5 * ((3.130495168 * 시간) cos).
  각속도 <- -0.5 * 3.130495168 * ((3.130495168 * 시간) sin).
  추x <- (각도) sin. 추y <- -((각도) cos).
  에너지 <- 0.5 * 각속도 * 각속도 + 4.9 * 각도 * 각도.
}.
추보기 := (보기=((x=추x,y=추y) 진자그림)) 표준보개.으뜸.
각도보기 := (보기=((각=각도) 각도기준그림),기준=추보기,순서=1) 표준보개.겹.
각도시간보기 := (보기=((시간=시간,각=각도) 진자각도그림),자리=#오른쪽) 표준보개.곁.
에너지시간보기 := (보기=((시간=시간,에너지=에너지) 진자에너지그림),자리=#오른쪽) 표준보개.곁.
추대상 := (중심=차림[추x,추y],반지름=0.08) 표준장면.원.
고정점대상 := (중심=차림[0,0],반지름=0.03) 표준장면.원.
추돋보기 := (대상=추대상,보기법=추자세히) 표준보개.돋.
고정점돋보기 := (대상=고정점대상,보기법=고정점자세히) 표준보개.돋.
진자짜임 := (관계들=차림[추보기,각도보기,각도시간보기,에너지시간보기,추돋보기,고정점돋보기]) 표준보개.짜임.
(시간:시간,각도:각도,각속도:각속도,에너지:에너지) 보임.
