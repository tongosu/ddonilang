// WO14: 그래프와 계산 방법을 함께 비교한다. 호스트 시간은 읽지 않는다.
설정 { 제목: "함수 탐구 · 근과 넓이". }.
이분횟수 := 12.
나눈수 := 8.
해석 := 0.
(가로:수) 함수값:수:셈씨 := { 함수값 <- 가로 * 가로 - 2. }.
(횟수:수) 양의근:수:셈씨 := {
  왼끝 <- 1. 오른끝 <- 2. 순서 <- 0.
  { 순서 < 횟수 }인 동안 {
    가운데 <- (왼끝 + 오른끝) / 2.
    { ((가로=가운데) 함수값) > 0 }이면 { 오른끝 <- 가운데. }
    아니면 { 왼끝 <- 가운데. }.
    순서 <- 순서 + 1.
  }.
  양의근 <- (왼끝 + 오른끝) / 2.
}.
(칸수:수) 제곱넓이:수:셈씨 := {
  간격 <- 1 / 칸수. 합계 <- 0. 번호 <- 0.
  { 번호 < 칸수 }인 동안 {
    왼값 <- 번호 * 간격. 오른값 <- (번호 + 1) * 간격.
    합계 <- 합계 + (왼값 * 왼값 + 오른값 * 오른값) * 간격 / 2.
    번호 <- 번호 + 1.
  }.
  제곱넓이 <- 합계.
}.
근 <- (횟수=이분횟수) 양의근.
잔차 <- (가로=근) 함수값.
거친넓이 <- (칸수=나눈수) 제곱넓이.
촘촘한넓이 <- (칸수=나눈수 * 2) 제곱넓이.
정확넓이 <- 1 / 3.
거친오차 <- 거친넓이 - 정확넓이.
촘촘한오차 <- 촘촘한넓이 - 정확넓이.
(표시근:수) 함수그림값:보기값:셈씨 := {
안내 := (자리=차림[0,2.3],내용="f(x)=x²−2 · 근은 y=0인 자리") 표준장면.글.
요소들 <- 차림[안내]. 번호 <- 0.
{ 번호 <= 32 }인 동안 {
  가로 <- 번호 / 16.
  점 <- (중심=차림[가로,((가로=가로) 함수값)],반지름=0.025) 표준장면.원.
  요소들 <- (요소들,점) 추가. 번호 <- 번호 + 1.
}.
장면 := (요소들=요소들,가로범위=차림[-0.2,2.2],세로범위=차림[-2.5,3]) 표준장면.평면.
함수그림값 <- (장면=장면) 표준보기.장면.
}.
(표시근:수) 근표시:보기값:셈씨 := {
근점 := (중심=차림[표시근,0],반지름=0.09) 표준장면.원.
근장면 := (요소들=차림[근점],가로범위=차림[-0.2,2.2],세로범위=차림[-2.5,3]) 표준장면.평면.
근표시 <- (장면=근장면) 표준보기.장면.
}.
(종류:수,표시근:수) 탐구그림값:보기값:셈씨 := {
  { 종류 == 0 }이면 { 탐구그림값 <- (표시근=표시근) 함수그림값. }
  아니면 {
    안내 := (자리=차림[0,-0.1],내용="y=x² · 0~1의 넓이 = 1/3") 표준장면.글.
    바닥 := (꼭짓점들=차림[차림[0,0],차림[1,0],차림[1,0.003],차림[0,0.003]]) 표준장면.다각형.
    요소들 <- 차림[안내,바닥]. 번호 <- 0.
    { 번호 <= 32 }인 동안 {
      가로 <- 번호 / 32.
      점 <- (중심=차림[가로,가로*가로],반지름=0.009) 표준장면.원.
      요소들 <- (요소들,점) 추가. 번호 <- 번호+1.
    }.
    장면 := (요소들=요소들,가로범위=차림[-0.1,1.1],세로범위=차림[-0.15,1.3]) 표준장면.평면.
    탐구그림값 <- (장면=장면) 표준보기.장면.
  }.
}.
(종류:수,표시근:수,칸수:수) 계산표시값:보기값:셈씨 := {
  { 종류 == 0 }이면 { 계산표시값 <- (표시근=표시근) 근표시. }
  아니면 {
    원점 := (중심=차림[0,0],반지름=0.009) 표준장면.원.
    요소들 <- 차림[원점]. 번호 <- 0. 간격 <- 1/칸수.
    { 번호 < 칸수 }인 동안 {
      왼끝 <- 번호*간격. 오른끝 <- (번호+1)*간격.
      { 번호 == 0 }이면 {
        조각 <- (꼭짓점들=차림[차림[왼끝,0],차림[오른끝,0],차림[오른끝,오른끝*오른끝]]) 표준장면.다각형.
      } 아니면 {
        조각 <- (꼭짓점들=차림[차림[왼끝,0],차림[오른끝,0],차림[오른끝,오른끝*오른끝],차림[왼끝,왼끝*왼끝]]) 표준장면.다각형.
      }.
      요소들 <- (요소들,조각) 추가. 번호 <- 번호+1.
    }.
    장면 := (요소들=요소들,가로범위=차림[-0.1,1.1],세로범위=차림[-0.15,1.3]) 표준장면.평면.
    계산표시값 <- (장면=장면) 표준보기.장면.
  }.
}.
함수그림 := (보기=((종류=해석,표시근=근) 탐구그림값)) 표준보개.으뜸.
계산표시 := (보기=((종류=해석,표시근=근,칸수=나눈수) 계산표시값),기준=함수그림,순서=1) 표준보개.겹.
계산비교 := (보기=(() 표준보기.결과표),자리=#오른쪽) 표준보개.곁.
탐구짜임 := (관계들=차림[함수그림,계산표시,계산비교]) 표준보개.짜임.
(이분횟수:이분횟수,근:근,잔차:잔차,칸수:나눈수,거친넓이:거친넓이,촘촘한넓이:촘촘한넓이,정확넓이:정확넓이,거친오차:거친오차,촘촘한오차:촘촘한오차) 보임.
