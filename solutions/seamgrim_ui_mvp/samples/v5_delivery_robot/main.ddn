(위치:수, 목적지:수) 배달그림:보기값:셈씨 := {
  길 := (꼭짓점들=차림[차림[0,-0.08],차림[목적지,-0.08],차림[목적지,0.08],차림[0,0.08]]) 표준장면.다각형.
  목적 := (중심=차림[목적지,0],반지름=0.35) 표준장면.원.
  몸체 := (꼭짓점들=차림[차림[위치-0.3,0.1],차림[위치+0.3,0.1],차림[위치+0.3,0.65],차림[위치-0.3,0.65]]) 표준장면.다각형.
  왼바퀴 := (중심=차림[위치-0.2,0],반지름=0.12) 표준장면.원.
  오른바퀴 := (중심=차림[위치+0.2,0],반지름=0.12) 표준장면.원.
  안내 := (자리=차림[0,1.3],내용="배달 로봇 · 속도는 칸/마디 · 장애물/충돌 없음") 표준장면.글.
  장면 := (요소들=차림[길,목적,몸체,왼바퀴,오른바퀴,안내],가로범위=차림[-1,10],세로범위=차림[-1,2]) 표준장면.평면.
  배달그림 <- (장면=장면) 표준보기.장면.
}.
실행:움직씨 := {
  (시작)할때 { 이동칸 <- 0. 지난마디 <- 0. 도착 <- 거짓. }.
  (매마디)마다 {
    속도:수 := 1 / 16.
    목적지:수 := 8.
    { 도착 == 거짓 }이면 {
      이동칸 <- 이동칸 + 속도.
      지난마디 <- 지난마디 + 1.
      { 이동칸 >= 목적지 }이면 { 이동칸 <- 목적지. 도착 <- 참. }.
    }.
  }.
  (이동칸:이동칸,도착:도착,걸린마디:지난마디) 내보임.
}.
로봇보기 := (보기=((위치=이동칸,목적지=8) 배달그림)) 표준보개.으뜸.
배달짜임 := (관계들=차림[로봇보기]) 표준보개.짜임.
