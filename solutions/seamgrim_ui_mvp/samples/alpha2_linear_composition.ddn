// 일차함수 y = 2x + 1: 한 번 실행. 으뜸 표본, 겹 기울기 삼각형, 곁 x-y 결과표, 돋 선택점.
// 으뜸의 표본 점을 누르면 그 점의 좌표가 돋에 나온다. 시간 진행은 없다.
x <- 1. y <- 2 * x + 1.
(현재x:수,현재y:수) 일차함수그림:보기값:셈씨 := {
  안내 := (자리=차림[-2,8],내용="y = 2x + 1 · 표본 간격 0.25") 표준장면.글.
  요소들 <- 차림[안내]. n <- -8.
  { n <= 12 }인 동안 {
    x <- n / 4. y <- 2 * x + 1.
    점 <- (중심=차림[x,y],반지름=0.035) 표준장면.원.
    요소들 <- (요소들,점) 추가. n <- n + 1.
  }.
  장면 := (요소들=요소들,가로범위=차림[-3,4],세로범위=차림[-4,9]) 표준장면.평면.
  일차함수그림 <- (장면=장면) 표준보기.장면.
}.
기울기그림:보기값:셈씨 := {
  삼각형 := (꼭짓점들=차림[차림[0,1],차림[1,1],차림[1,3]]) 표준장면.다각형.
  가로글 := (자리=차림[0,0.5],내용="Δx = 1") 표준장면.글.
  세로글 := (자리=차림[1.1,2],내용="Δy = 2") 표준장면.글.
  안내 := (자리=차림[-2,7.3],내용="겹: 기울기 = Δy / Δx = 2") 표준장면.글.
  장면 := (요소들=차림[삼각형,가로글,세로글,안내],가로범위=차림[-3,4],세로범위=차림[-4,9]) 표준장면.평면.
  기울기그림 <- (장면=장면) 표준보기.장면.
}.
(대상:장면요소값) 점자세히:보기값:셈씨 := {
  안내 := (자리=차림[-2,8],내용="돋: 선택한 표본 점 · 아래에 x-y 좌표") 표준장면.글.
  장면 := (요소들=차림[대상,안내],가로범위=차림[-3,4],세로범위=차림[-4,9]) 표준장면.평면.
  점자세히 <- (장면=장면) 표준보기.장면.
}.
함수보기 := (보기=((현재x=x,현재y=y) 일차함수그림)) 표준보개.으뜸.
기울기보기 := (보기=(() 기울기그림),기준=함수보기,순서=1) 표준보개.겹.
표보기 := (보기=(() 표준보기.결과표),자리=#오른쪽) 표준보개.곁.
// 각 돋은 별도 작성 관계이다. 반복의 같은 선언 위치를 정체로 재사용하지 않는다.
점대상0 := (중심=차림[-2,-3],반지름=0.035) 표준장면.원.
점돋0 := (대상=점대상0,보기법=점자세히) 표준보개.돋.
점대상1 := (중심=차림[-1.75,-2.5],반지름=0.035) 표준장면.원.
점돋1 := (대상=점대상1,보기법=점자세히) 표준보개.돋.
점대상2 := (중심=차림[-1.5,-2],반지름=0.035) 표준장면.원.
점돋2 := (대상=점대상2,보기법=점자세히) 표준보개.돋.
점대상3 := (중심=차림[-1.25,-1.5],반지름=0.035) 표준장면.원.
점돋3 := (대상=점대상3,보기법=점자세히) 표준보개.돋.
점대상4 := (중심=차림[-1,-1],반지름=0.035) 표준장면.원.
점돋4 := (대상=점대상4,보기법=점자세히) 표준보개.돋.
점대상5 := (중심=차림[-0.75,-0.5],반지름=0.035) 표준장면.원.
점돋5 := (대상=점대상5,보기법=점자세히) 표준보개.돋.
점대상6 := (중심=차림[-0.5,0],반지름=0.035) 표준장면.원.
점돋6 := (대상=점대상6,보기법=점자세히) 표준보개.돋.
점대상7 := (중심=차림[-0.25,0.5],반지름=0.035) 표준장면.원.
점돋7 := (대상=점대상7,보기법=점자세히) 표준보개.돋.
점대상8 := (중심=차림[0,1],반지름=0.035) 표준장면.원.
점돋8 := (대상=점대상8,보기법=점자세히) 표준보개.돋.
점대상9 := (중심=차림[0.25,1.5],반지름=0.035) 표준장면.원.
점돋9 := (대상=점대상9,보기법=점자세히) 표준보개.돋.
점대상10 := (중심=차림[0.5,2],반지름=0.035) 표준장면.원.
점돋10 := (대상=점대상10,보기법=점자세히) 표준보개.돋.
점대상11 := (중심=차림[0.75,2.5],반지름=0.035) 표준장면.원.
점돋11 := (대상=점대상11,보기법=점자세히) 표준보개.돋.
점대상12 := (중심=차림[1,3],반지름=0.035) 표준장면.원.
점돋12 := (대상=점대상12,보기법=점자세히) 표준보개.돋.
점대상13 := (중심=차림[1.25,3.5],반지름=0.035) 표준장면.원.
점돋13 := (대상=점대상13,보기법=점자세히) 표준보개.돋.
점대상14 := (중심=차림[1.5,4],반지름=0.035) 표준장면.원.
점돋14 := (대상=점대상14,보기법=점자세히) 표준보개.돋.
점대상15 := (중심=차림[1.75,4.5],반지름=0.035) 표준장면.원.
점돋15 := (대상=점대상15,보기법=점자세히) 표준보개.돋.
점대상16 := (중심=차림[2,5],반지름=0.035) 표준장면.원.
점돋16 := (대상=점대상16,보기법=점자세히) 표준보개.돋.
점대상17 := (중심=차림[2.25,5.5],반지름=0.035) 표준장면.원.
점돋17 := (대상=점대상17,보기법=점자세히) 표준보개.돋.
점대상18 := (중심=차림[2.5,6],반지름=0.035) 표준장면.원.
점돋18 := (대상=점대상18,보기법=점자세히) 표준보개.돋.
점대상19 := (중심=차림[2.75,6.5],반지름=0.035) 표준장면.원.
점돋19 := (대상=점대상19,보기법=점자세히) 표준보개.돋.
점대상20 := (중심=차림[3,7],반지름=0.035) 표준장면.원.
점돋20 := (대상=점대상20,보기법=점자세히) 표준보개.돋.
일차함수짜임 := (관계들=차림[함수보기,기울기보기,표보기,점돋0,점돋1,점돋2,점돋3,점돋4,점돋5,점돋6,점돋7,점돋8,점돋9,점돋10,점돋11,점돋12,점돋13,점돋14,점돋15,점돋16,점돋17,점돋18,점돋19,점돋20]) 표준보개.짜임.
표본들 <- 차림[-2,-1,0,1,2,3].
표본들마다 { (x:표본들,y:2*표본들+1,기울기:2) 보임. }.
