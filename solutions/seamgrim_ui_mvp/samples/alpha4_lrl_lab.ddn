(그림=공용그림) 쓰임.
// 무차원 중앙힘: 질량=1, 중력계수=1. 아래 초기값을 바꾼 뒤 처음부터 재실행한다.
// 가속도=-r벡터/r^3-섭동*r벡터/r^4. LRL은 섭동=0에서만 보존량이다.
설정 { 제목: "LRL · 궤도와 속도 원". 마디수: 600. }.
이심률 := 0.5.
섭동 := 0.
속도배율 := 1.
간격 := 0.01.
발사설정 := 0.
발사가로속도 := 0.
발사세로속도 := 1.2.
(궤도값인자:차림,섭동값:수) 변화율:차림:셈씨 := {
  반경 <- (궤도값인자[0]*궤도값인자[0]+궤도값인자[1]*궤도값인자[1]) sqrt.
  계수 <- -1/(반경*반경*반경)-섭동값/(반경*반경*반경*반경).
  변화율 <- 차림[궤도값인자[2],궤도값인자[3],계수*궤도값인자[0],계수*궤도값인자[1]].
}.
(궤도값인자:차림,변화:차림,폭:수) 옮긴값:차림:셈씨 := {
  옮긴값 <- 차림[궤도값인자[0]+폭*변화[0],궤도값인자[1]+폭*변화[1],궤도값인자[2]+폭*변화[2],궤도값인자[3]+폭*변화[3]].
}.
(궤도값인자:차림,폭:수,섭동값:수) 다음값:차림:셈씨 := {
  첫값 := (궤도값인자=궤도값인자,섭동값=섭동값) 변화율.
  둘째값 := (궤도값인자=((궤도값인자=궤도값인자,변화=첫값,폭=폭/2) 옮긴값),섭동값=섭동값) 변화율.
  셋째값 := (궤도값인자=((궤도값인자=궤도값인자,변화=둘째값,폭=폭/2) 옮긴값),섭동값=섭동값) 변화율.
  넷째값 := (궤도값인자=((궤도값인자=궤도값인자,변화=셋째값,폭=폭) 옮긴값),섭동값=섭동값) 변화율.
  다음값 <- 차림[궤도값인자[0]+폭*(첫값[0]+2*둘째값[0]+2*셋째값[0]+넷째값[0])/6,궤도값인자[1]+폭*(첫값[1]+2*둘째값[1]+2*셋째값[1]+넷째값[1])/6,궤도값인자[2]+폭*(첫값[2]+2*둘째값[2]+2*셋째값[2]+넷째값[2])/6,궤도값인자[3]+폭*(첫값[3]+2*둘째값[3]+2*셋째값[3]+넷째값[3])/6].
}.
// [반경, 각운동량, 전체에너지, Ax, Ay]. 섭동 퍼텐셜은 -ε/(2r²).
(궤도값인자:차림,섭동값:수) 물리량:차림:셈씨 := {
  반경 <- (궤도값인자[0]*궤도값인자[0]+궤도값인자[1]*궤도값인자[1]) sqrt.
  각운동 <- 궤도값인자[0]*궤도값인자[3]-궤도값인자[1]*궤도값인자[2].
  물리량 <- 차림[반경,각운동,(궤도값인자[2]*궤도값인자[2]+궤도값인자[3]*궤도값인자[3])/2-1/반경-섭동값/(2*반경*반경),궤도값인자[3]*각운동-궤도값인자[0]/반경,-궤도값인자[2]*각운동-궤도값인자[1]/반경].
}.
(점들:차림,현재점:차림,속도그림:참거짓,처음량:차림) 궤적그림:보기값:셈씨 := {
  질점 := (중심=현재점,반지름=0.045) 표준장면.원.
  요소들 <- 차림[질점]. 번호 <- 0.
  { 번호 < (점들) 길이 }인 동안 {
    점 <- (중심=점들[번호],반지름=0.012) 표준장면.원.
    요소들 <- (요소들,점) 추가. 번호 <- 번호+1.
  }.
  { 속도그림 }이면 {
    // ε=0에서 예상되는 속도 원. ε≠0이면 초기 궤도값인자의 비교 원일 뿐이다.
    원 := (중심=차림[-처음량[4]/처음량[1],처음량[3]/처음량[1]],반지름=1/처음량[1]) 표준장면.원.
    표지 := (자리=차림[-2.7,2.0],내용="속도평면 vx·vy / 초기 케플러 비교 원") 표준장면.글.
    요소들 <- (요소들,원) 추가. 요소들 <- (요소들,표지) 추가.
    장면 := (요소들=요소들,가로범위=차림[-3,3],세로범위=차림[-3,3]) 표준장면.평면.
    궤적그림 <- (장면=장면) 표준보기.장면.
  } 아니면 {
    중심 := (중심=차림[0,0],반지름=0.045) 표준장면.원.
    표지 := (자리=차림[-2,1.95],내용="위치평면 x·y / 5마디마다 궤적, 최대600표본") 표준장면.글.
    요소들 <- (요소들,중심) 추가. 요소들 <- (요소들,표지) 추가.
    장면 := (요소들=요소들,가로범위=차림[-2.2,2.2],세로범위=차림[-2.2,2.2]) 표준장면.평면.
    궤적그림 <- (장면=장면) 표준보기.장면.
  }.
}.
(궤도값인자:차림,양:차림) 분해그림:보기값:셈씨 := {
  bx <- 궤도값인자[3]*양[1]. by <- -궤도값인자[2]*양[1].
  cx <- -궤도값인자[0]/양[0]. cy <- -궤도값인자[1]/양[0].
  표지 := (자리=차림[-2,1.7],내용="A = B + C / B=p×L / C=-r단위벡터 / 0벡터는 화살표 없음") 표준장면.글.
  요소들 <- 차림[표지].
  b길이 <- (bx*bx+by*by) sqrt.
  { b길이 > 0.0001 }이면 {
    b화살 <- (꼭짓점들=((끝x=bx,끝y=by) 그림.화살꼭짓점)) 표준장면.다각형.
    b표지 <- (자리=차림[bx,by+0.08],내용="B") 표준장면.글.
    요소들 <- (요소들,b화살) 추가. 요소들 <- (요소들,b표지) 추가.
  }.
  c화살 := (꼭짓점들=((끝x=cx,끝y=cy) 그림.화살꼭짓점)) 표준장면.다각형.
  c표지 := (자리=차림[cx,cy+0.08],내용="C") 표준장면.글.
  요소들 <- (요소들,c화살) 추가. 요소들 <- (요소들,c표지) 추가.
  a길이 <- (양[3]*양[3]+양[4]*양[4]) sqrt.
  { a길이 > 0.0001 }이면 {
    a화살 <- (꼭짓점들=((끝x=양[3],끝y=양[4]) 그림.화살꼭짓점)) 표준장면.다각형.
    a표지 <- (자리=차림[양[3],양[4]+0.08],내용="A") 표준장면.글.
    요소들 <- (요소들,a화살) 추가. 요소들 <- (요소들,a표지) 추가.
  }.
  장면 := (요소들=요소들,가로범위=차림[-2.2,2.2],세로범위=차림[-2.2,2.2]) 표준장면.평면.
  분해그림 <- (장면=장면) 표준보기.장면.
}.
실행:움직씨 := {
(시작)할때 {
  초기반경 <- 1-이심률.
  초기속도 <- 속도배율*((((1+이심률)/초기반경)) sqrt).
  궤도값 <- 차림[초기반경,0,0,초기속도].
  { 발사설정 == 1 }이면 { 궤도값 <- 차림[초기반경,0,발사가로속도,발사세로속도]. }.
  고운값 <- 궤도값.
  처음량 <- (궤도값인자=궤도값,섭동값=섭동) 물리량.
  시간 <- 0. 표본수 <- 0. 표본시계 <- 0. 위치점들 <- 차림[차림[초기반경,0]]. 속도점들 <- 차림[차림[0,초기속도]]. 멈춤 <- 거짓.
}.
(매마디)마다 {
  반경 <- (궤도값[0]*궤도값[0]+궤도값[1]*궤도값[1]) sqrt.
  { 반경 > 0.05 그리고 반경 < 20 그리고 멈춤 == 거짓 }이면 {
    궤도값 <- (궤도값인자=궤도값,폭=간격,섭동값=섭동) 다음값.
    고운값 <- (궤도값인자=고운값,폭=간격/2,섭동값=섭동) 다음값.
    고운값 <- (궤도값인자=고운값,폭=간격/2,섭동값=섭동) 다음값.
    시간 <- 시간+간격.
    표본시계 <- 표본시계+1.
    { 표본수 < 600 그리고 표본시계 == 5 }이면 {
      위치점들 <- (위치점들,차림[궤도값[0],궤도값[1]]) 추가.
      속도점들 <- (속도점들,차림[궤도값[2],궤도값[3]]) 추가.
      표본수 <- 표본수+1. 표본시계 <- 0.
    }.
  } 아니면 { 멈춤 <- 참. }.
  현재량 <- (궤도값인자=궤도값,섭동값=섭동) 물리량.
  에너지변화 <- 현재량[2]-처음량[2]. 각운동변화 <- 현재량[1]-처음량[1].
  LRL변화 <- (((현재량[3]-처음량[3])*(현재량[3]-처음량[3])+(현재량[4]-처음량[4])*(현재량[4]-처음량[4]))) sqrt.
  반간격차 <- (((궤도값[0]-고운값[0])*(궤도값[0]-고운값[0])+(궤도값[1]-고운값[1])*(궤도값[1]-고운값[1]))) sqrt.
  A제곱 <- 현재량[3]*현재량[3]+현재량[4]*현재량[4].
  A검산오차 <- A제곱-(1+2*현재량[2]*현재량[1]*현재량[1]).
  방향있음 <- A제곱 > 0.00000001. 방향변화 <- 0.
  { 방향있음 그리고 처음량[3]*처음량[3]+처음량[4]*처음량[4] > 0.00000001 }이면 {
    방향변화 <- (처음량[3]*현재량[4]-처음량[4]*현재량[3],처음량[3]*현재량[3]+처음량[4]*현재량[4]) atan2.
  }.
  (시간:시간,x:궤도값[0],y:궤도값[1],vx:궤도값[2],vy:궤도값[3],각운동량:현재량[1],에너지:현재량[2],Ax:현재량[3],Ay:현재량[4],A제곱:A제곱,A검산오차:A검산오차,방향변화:방향변화,방향있음:방향있음,에너지변화:에너지변화,각운동변화:각운동변화,LRL변화:LRL변화,반간격차:반간격차,멈춤:멈춤) 보임.
}.
}.
위치궤도 := (보기=((점들=위치점들,현재점=차림[궤도값[0],궤도값[1]],속도그림=거짓,처음량=처음량) 궤적그림)) 표준보개.으뜸.
LRL분해 := (보기=((궤도값인자=궤도값,양=현재량) 분해그림),기준=위치궤도,순서=1) 표준보개.겹.
호도그래프 := (보기=((점들=속도점들,현재점=차림[궤도값[2],궤도값[3]],속도그림=참,처음량=처음량) 궤적그림),자리=#오른쪽) 표준보개.곁.
측정판 := (보기=(() 표준보기.결과표),자리=#오른쪽) 표준보개.곁.
LRL실험짜임 := (관계들=차림[위치궤도,LRL분해,호도그래프,측정판]) 표준보개.짜임.
