// WO14 작은 시장: 선형 수요/공급의 균형과 단위 세금. 실제 시장 예측이 아니다.
설정 { 제목: "작은 시장 · 복리와 세금". }.
처음돈 := 1000.
이자율 := 0.05.
해수 := 5.
세금 := 8.
시장해석 := 0.
(처음:수,비율:수,기간:수) 복리금액:수:셈씨 := {
  금액 <- 처음. 해 <- 0.
  { 해 < 기간 }인 동안 { 금액 <- 금액 * (1 + 비율). 해 <- 해 + 1. }.
  복리금액 <- 금액.
}.
// Qd=100−5Pc, Qs=20+3Ps, Pc=Ps+세금.
세전가격 <- 10. 세전수량 <- 50.
소비가격 <- (80 + 3 * 세금) / 8.
생산가격 <- 소비가격 - 세금.
거래수량 <- 100 - 5 * 소비가격.
세수 <- 세금 * 거래수량.
소비부담 <- 소비가격 - 세전가격.
생산부담 <- 세전가격 - 생산가격.
복리결과 <- (처음=처음돈,비율=이자율,기간=해수) 복리금액.
단리결과 <- 처음돈 * (1 + 이자율 * 해수).
복리차이 <- 복리결과 - 단리결과.
(세액:수) 시장그림:보기값:셈씨 := {
  수요 := (꼭짓점들=차림[차림[0,20],차림[100,0],차림[100,0.06],차림[0,20.06]]) 표준장면.다각형.
  공급 := (꼭짓점들=차림[차림[20,0],차림[80,20],차림[80,20.06],차림[20,0.06]]) 표준장면.다각형.
  균형 := (중심=차림[50,10],반지름=0.5) 표준장면.원.
  가로축 := (꼭짓점들=차림[차림[0,0],차림[100,0],차림[100,0.06],차림[0,0.06]]) 표준장면.다각형.
  세로축 := (꼭짓점들=차림[차림[0,0],차림[0.16,0],차림[0.16,24],차림[0,24]]) 표준장면.다각형.
  수요이름 := (자리=차림[78,6],내용="수요") 표준장면.글.
  공급이름 := (자리=차림[65,13],내용="세전 공급") 표준장면.글.
  수량눈금 := (자리=차림[48,1],내용="Q=50") 표준장면.글.
  가격눈금 := (자리=차림[2,10],내용="P=10") 표준장면.글.
  설명 := (자리=차림[3,23],내용="Q: 수량 · P: 가격 · 세전 균형 (50,10)") 표준장면.글.
  장면 := (요소들=차림[수요,공급,균형,가로축,세로축,수요이름,공급이름,수량눈금,가격눈금,설명],가로범위=차림[-5,105],세로범위=차림[-1,26]) 표준장면.평면.
  시장그림 <- (장면=장면) 표준보기.장면.
}.
(세액:수,수량:수,사는값:수,파는값:수) 세금그림:보기값:셈씨 := {
  올린공급 := (꼭짓점들=차림[차림[0,-20/3+세액],차림[80,20+세액],차림[80,20+세액+0.06],차림[0,-20/3+세액+0.06]]) 표준장면.다각형.
  소비점 := (중심=차림[수량,사는값],반지름=0.7) 표준장면.원.
  생산점 := (중심=차림[수량,파는값],반지름=0.5) 표준장면.원.
  세후이름 := (자리=차림[25,세액+5],내용="세후 공급") 표준장면.글.
  요소들 <- 차림[올린공급,소비점,생산점,세후이름].
  { 세액 > 0 }이면 {
    간격표시 <- (꼭짓점들=차림[차림[수량-0.12,파는값],차림[수량+0.12,파는값],차림[수량+0.12,사는값],차림[수량-0.12,사는값]]) 표준장면.다각형.
    요소들 <- (요소들,간격표시) 추가.
  }.
  장면 := (요소들=요소들,가로범위=차림[-5,105],세로범위=차림[-1,26]) 표준장면.평면.
  세금그림 <- (장면=장면) 표준보기.장면.
}.
(처음:수,비율:수,기간:수,복리여부:참거짓) 돈의그림:보기값:셈씨 := {
  이름 <- "단리: 해마다 처음 돈에 이자". 안내높이 <- 0.15.
  { 복리여부 }이면 { 이름 <- "복리: 해마다 앞 해 돈에 이자". 안내높이 <- 0.4. }.
  안내 := (자리=차림[0,안내높이],내용=이름) 표준장면.글.
  눈금 := (자리=차림[0,2.6],내용="가로: 년 · 세로: 금액(천)") 표준장면.글.
  영년 := (자리=차림[0,0.75],내용="0년") 표준장면.글.
  오년 := (자리=차림[5/3,0.75],내용="5년") 표준장면.글.
  십년 := (자리=차림[10/3,0.75],내용="10년") 표준장면.글.
  요소들 <- 차림[안내].
  { 복리여부 }이면 { } 아니면 {
    요소들 <- (요소들,눈금) 추가. 요소들 <- (요소들,영년) 추가.
    요소들 <- (요소들,오년) 추가. 요소들 <- (요소들,십년) 추가.
  }.
  해 <- 0. 지난값 <- 처음/1000.
  { 해 <= 기간 }인 동안 {
    금액 <- 처음 * (1+비율*해).
    { 복리여부 }이면 { 금액 <- (처음=처음,비율=비율,기간=해) 복리금액. }.
    높이 <- 금액/1000.
    점 <- (중심=차림[해/3,높이],반지름=0.025) 표준장면.원.
    요소들 <- (요소들,점) 추가.
    { 해 > 0 }이면 {
      줄 <- (꼭짓점들=차림[차림[(해-1)/3,지난값],차림[해/3,높이],차림[해/3,높이+0.008],차림[(해-1)/3,지난값+0.008]]) 표준장면.다각형.
      요소들 <- (요소들,줄) 추가.
    }.
    지난값 <- 높이. 해 <- 해+1.
  }.
  장면 := (요소들=요소들,가로범위=차림[-0.2,3.55],세로범위=차림[0,3]) 표준장면.평면.
  돈의그림 <- (장면=장면) 표준보기.장면.
}.
(종류:수,처음:수,비율:수,기간:수,세액:수) 시장또는돈:보기값:셈씨 := {
  { 종류 == 0 }이면 { 시장또는돈 <- (세액=세액) 시장그림. }
  아니면 { 시장또는돈 <- (처음=처음,비율=비율,기간=기간,복리여부=거짓) 돈의그림. }.
}.
(종류:수,처음:수,비율:수,기간:수,세액:수,수량:수,사는값:수,파는값:수) 비교그림값:보기값:셈씨 := {
  { 종류 == 0 }이면 { 비교그림값 <- (세액=세액,수량=수량,사는값=사는값,파는값=파는값) 세금그림. }
  아니면 { 비교그림값 <- (처음=처음,비율=비율,기간=기간,복리여부=참) 돈의그림. }.
}.
기준그림 := (보기=((종류=시장해석,처음=처음돈,비율=이자율,기간=해수,세액=세금) 시장또는돈)) 표준보개.으뜸.
비교표시 := (보기=((종류=시장해석,처음=처음돈,비율=이자율,기간=해수,세액=세금,수량=거래수량,사는값=소비가격,파는값=생산가격) 비교그림값),기준=기준그림,순서=1) 표준보개.겹.
금액과부담 := (보기=(() 표준보기.결과표),자리=#오른쪽) 표준보개.곁.
시장짜임 := (관계들=차림[기준그림,비교표시,금액과부담]) 표준보개.짜임.
(세금:세금,소비가격:소비가격,생산가격:생산가격,거래수량:거래수량,세수:세수,소비부담:소비부담,생산부담:생산부담,복리:복리결과,단리:단리결과,차이:복리차이) 보임.
