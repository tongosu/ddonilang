    },
    {
      "rd": "RD-239",
      "source_file": "docs/ssot/ssot/SSOT_DECISIONS_v25.151.0.md",
      "source_line": 1933,
      "source_row_sha256": "6434e407b0ae1c59bcb298f5b3e20f97459af11655dd8d93cb0713fcff94fa43",
      "source_status_literal": "OWNER-APPROVED A / SEMANTICS-CLOSED / PHYSICAL-SCHEMA-OPEN / PRODUCT-OPEN",
      "public_target": "SPEC_CURRENT_VIEW_v0.9.0.md",
